# 削除予定ファイルの一時置き場
_del/

# Claude Code のローカル設定
.claude/settings.local.json

# 環境変数・秘密情報
.env
.env.*

# OS / エディタ
.DS_Store
Thumbs.db

# Node / TypeScript ビルド生成物
# (examples/out の SVG は README とメモから参照するのでコミット対象)
node_modules/
# Make が使う場所: 作り直しの記録 (印) と、.vsix を詰める作業場。
# 作業場は依存を入れたまま残す (2 回目からの install を速くするため) ので
# 1 GB 近くなる。捨てるのは `make clean`。
/.build/
dist/
/out/
*.vsix
*.tgz
*.tsbuildinfo

# テスト生成物
coverage/
.vscode-test/
# 本物の VS Code で回す試験の束 (`packages/tommie-fence/esbuild.e2e.mjs`)
dist-test/
# @vscode/test-web が落とす web 版の VS Code
.vscode-test-web/

# LaTeX ビルド生成物 (circuitikz の検証用に .tex を回すことがある)
.latex-build/

# Playwright
.playwright-mcp/
test-results/

# Codespaces のデモが落とす .vsix (Releases から取るのでコミットしない)
/.devcontainer/vsix/
# 3 つのコアから写した資材 (`packages/tommie-fence/scripts/assets.mjs` が作る)。
# 原本はコアのまま — 追跡すると 2 か所に分かれる。
packages/tommie-fence/media/
packages/tommie-fence/syntaxes/
packages/tommie-fence/schemas/

# 例と文書の図の PNG は、本文 (Markdown) から指している物だけを追跡する (52 の docs/164)。
# 図の右下に版が入るので、描き直すたびに PNG が全部変わり、差分で縮まずに履歴へ丸ごと積もる。
# 指されている物は追跡したまま (無視の指定は追跡中のファイルに効かない)。過不足は scripts/images.mjs が直す。
packages/*/examples/out/**/*.png
packages/*/docs/out/**/*.png
