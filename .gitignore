# 削除予定ファイルの一時置き場
_del/

# Claude Code のローカル設定
.claude/settings.local.json

# 環境変数・秘密情報
.env
.env.*

# OS / エディタ
.DS_Store
Thumbs.db

# Node / TypeScript ビルド生成物
# (examples/out の SVG は README とメモから参照するのでコミット対象)
node_modules/
# Make が使う場所: 作り直しの記録 (印) と、.vsix を詰める作業場。
# 作業場は依存を入れたまま残す (2 回目からの install を速くするため) ので
# 1 GB 近くなる。捨てるのは `make clean`。
/.build/
dist/
/out/
*.vsix
*.tgz
*.tsbuildinfo

# テスト生成物
coverage/
.vscode-test/

# LaTeX ビルド生成物 (circuitikz の検証用に .tex を回すことがある)
.latex-build/

# Playwright
.playwright-mcp/
test-results/

# Codespaces のデモが落とす .vsix (Releases から取るのでコミットしない)
/.devcontainer/vsix/
