{
  "name": "perfboard-fence",
  "displayName": "Perfboard Fence",
  "description": "Markdown の ```perfboard フェンスをユニバーサル基板の実体配線図としてプレビューする",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "publisher": "tommie",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommie-jp/tommie-fence.git",
    "directory": "packages/perfboard-fence"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "perfboard",
    "stripboard",
    "electronics",
    "diagram"
  ],
  "exports": {
    "./core": "./src/core/index.ts",
    "./editor": "./src/core/edit/fenceEditor.ts",
    "./package.json": "./package.json",
    "./plugin": "./src/markdownItPlugin.ts"
  },
  "bin": {
    "perfboard-fence": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "schematics": "node ../circuit-fence/dist/cli.cjs render examples/06-ic.md --out examples/out/schematic",
    "examples": "npm run build && node dist/cli.cjs render examples --out examples/out && node scripts/png.mjs",
    "docs": "npm run build && node dist/cli.cjs render docs/01-syntax.md --out docs/out"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "fence-kit": "*",
    "markdown-it": "^15.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
