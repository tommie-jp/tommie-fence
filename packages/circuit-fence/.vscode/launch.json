{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "拡張機能を起動 (examples を開く)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: build",
      "sourceMaps": true
    }
  ]
}
