{
  "name": "circuit-fence",
  "displayName": "Circuit Fence",
  "description": "Markdown の ```circuit フェンスを回路図としてプレビューする",
  "version": "0.5.0",
  "license": "MIT",
  "private": true,
  "publisher": "tommie",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommie-jp/tommie-fence.git",
    "directory": "packages/circuit-fence"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "circuit",
    "circuitikz",
    "schematic",
    "diagram"
  ],
  "exports": {
    "./core": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./editor": "./src/core/edit/fenceEditor.ts",
    "./src/core": "./src/core/index.ts",
    "./package.json": "./package.json",
    "./plugin": "./src/markdownItPlugin.ts",
    "./queue": "./src/host/renderQueue.ts",
    "./tex": "./src/host/texSvg.ts",
    "./tex.web": "./src/host/texSvg.web.ts",
    "./src/core/*": "./src/core/*"
  },
  "bin": {
    "circuit-fence": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "types": "tsc -p tsconfig.types.json",
    "prepack": "rm -rf dist && node esbuild.mjs --production && npm run types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "examples": "npm run build && node dist/cli.cjs render examples --out examples/out && node scripts/figures.mjs examples examples/out",
    "docs": "npm run build && node dist/cli.cjs render docs/01-syntax.md --out docs/out && node scripts/figures.mjs docs/01-syntax.md docs/out",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "node-tikzjax": "^1.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "fence-kit": "*",
    "markdown-it": "^15.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
