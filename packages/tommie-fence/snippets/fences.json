{
  "circuit fence": {
    "prefix": ["circuit"],
    "description": "Schematic — a circuit fence to start from (回路図のフェンス)",
    "body": [
      "```circuit",
      "title: ${1:RC low-pass}",
      "parts:",
      "  IN:  port a1",
      "  R1:  resistor a1 a2 10k",
      "  C1:  capacitor a2 b2 100n",
      "  OUT: port a3",
      "  G1:  ground b2",
      "wires:",
      "  - a2 -- a3$0",
      "```"
    ]
  },
  "breadboard fence": {
    "prefix": ["bread", "breadboard"],
    "description": "Breadboard wiring — a bread fence to start from (ブレッドボードのフェンス)",
    "body": [
      "```bread",
      "title: ${1:An LED and a resistor}",
      "board: half",
      "parts:",
      "  R1: resistor a5 a10 330",
      "  D1: led b12(A) b13(K) red",
      "wires:",
      "  - +t5 -- a5 red",
      "  - a10 -- b12",
      "  - c13 -- -t13 black$0",
      "```"
    ]
  },
  "perfboard fence": {
    "prefix": ["perf", "perfboard"],
    "description": "Perfboard layout — a perf fence to start from (ユニバーサル基板のフェンス)",
    "body": [
      "```perf",
      "board: 16x8",
      "title: ${1:An LED and a resistor}",
      "points:",
      "  VCC: a1",
      "  GND: f1",
      "parts:",
      "  R1: resistor c3 c7 330",
      "  D1: led c9 c11 red",
      "wires:",
      "  - VCC -- a3",
      "  - a3 -- c3",
      "  - c7 -- c9",
      "  - c11 -- f11",
      "  - f11 -- GND$0",
      "```"
    ]
  },
  "copper fence": {
    "prefix": ["copper"],
    "description": "Copper-clad board — a copper fence to start from (銅張り基板・マイクロストリップのフェンス)",
    "body": [
      "```copper",
      "board: 40x20mm",
      "title: ${1:A 50-ohm through line}",
      "copper:",
      "  L1: line 0,10 40,10 3.06mm",
      "parts:",
      "  J1: sma left 10",
      "  J2: sma right 10$0",
      "```"
    ]
  },
  "vna fence": {
    "prefix": ["vna"],
    "description": "VNA screen — a vna fence to start from (VNA・NanoVNA の画面のフェンス)",
    "body": [
      "```vna",
      "device: litevna64",
      "sweep: ${1:1M-300M 101}",
      "title: ${2:A 100-ohm resistor in series}",
      "dut: series R 100",
      "traces:",
      "  - S21 logmag",
      "  - S11 logmag",
      "  - S11 smith",
      "markers:",
      "  - 10M$0",
      "```"
    ]
  },
  "scope fence": {
    "prefix": ["scope"],
    "description": "Oscilloscope screen — a scope fence to start from (オシロスコープの画面のフェンス)",
    "body": [
      "```scope",
      "title: ${1:RC charging — the screen you should see}",
      "time: ${2:1ms/div}",
      "trigger: ch1 rising 1V",
      "ch1: square 100Hz 1V offset 1V",
      "ch2: ch1 | rc 1ms$0",
      "```"
    ]
  },
  "spectrum fence": {
    "prefix": ["spectrum"],
    "description": "Spectrum screen (FFT or swept) — a spectrum fence to start from (スペクトラムの画面のフェンス)",
    "body": [
      "```spectrum",
      "title: ${1:Harmonics of a 100 MHz square wave}",
      "device: ${2:tinysa-ultra}",
      "sweep: 0-960M 450",
      "rbw: 300kHz",
      "ref: 0dBm",
      "signal: square 100MHz -10dBm",
      "markers: [100M, 300M, 500M]$0",
      "```"
    ]
  },
  "graph fence": {
    "prefix": ["graph"],
    "description": "Textbook graph (frequency response, characteristic curve) — a graph fence to start from (グラフのフェンス)",
    "body": [
      "```graph",
      "title: ${1:図01 RC ローパスの利得}",
      "x: ${2:周波数 Hz log 100..100k}",
      "lines:",
      "  ${3:利得 dB}: ${4:20*log10(1/sqrt(1+(x/1.59k)^2))}$0",
      "```"
    ]
  }
}
