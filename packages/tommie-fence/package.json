{
  "name": "tommie-fence",
  "displayName": "tommie-fence",
  "description": "%description%",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "publisher": "tommie",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommie-jp/tommie-fence.git",
    "directory": "packages/tommie-fence"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.web.cjs",
  "l10n": "./l10n",
  "scripts": {
    "build": "node scripts/assets.mjs && node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/assets.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "vscode:prepublish": "node scripts/assets.mjs && node esbuild.mjs --production",
    "test:e2e": "npm run build && node esbuild.e2e.mjs && node scripts/e2e.mjs",
    "test:web": "npm run build && node esbuild.e2e.mjs && npx -y -p @vscode/test-web@0.0.81 -- playwright install chromium && npx -y @vscode/test-web@0.0.81 --browserType=chromium --headless --quality=stable --port=3791 --extensionDevelopmentPath=. --extensionTestsPath=dist-test/e2e/web.cjs ../../examples"
  },
  "dependencies": {
    "node-tikzjax": "^1.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "breadboard-fence": "*",
    "circuit-fence": "*",
    "esbuild": "^0.28.2",
    "fence-kit": "*",
    "markdown-it": "^15.0.0",
    "perfboard-fence": "*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tommie-fence.map",
        "displayName": "Fence Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/circuit.css",
      "./media/breadboard.css",
      "./media/perfboard.css",
      "./node_modules/node-tikzjax/css/fonts.css"
    ],
    "grammars": [
      {
        "scopeName": "markdown.circuit.codeblock",
        "path": "./syntaxes/circuit-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "scopeName": "markdown.breadboard.codeblock",
        "path": "./syntaxes/breadboard-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "scopeName": "markdown.perfboard.codeblock",
        "path": "./syntaxes/perfboard-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/fences.json"
      }
    ],
    "commands": [
      {
        "command": "tommie-fence.openMap",
        "title": "%command.openMap%",
        "category": "tommie-fence",
        "icon": "$(circuit-board)"
      },
      {
        "command": "circuit-fence.movePart",
        "title": "%command.movePart%",
        "category": "tommie-fence"
      },
      {
        "command": "circuit-fence.movePoint",
        "title": "%command.movePoint%",
        "category": "tommie-fence"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tommie-fence.openMap",
          "group": "navigation",
          "when": "resourceLangId == markdown && tommieFence.hasFence"
        }
      ],
      "commandPalette": [
        {
          "command": "tommie-fence.openMap",
          "when": "editorLangId == markdown"
        },
        {
          "command": "circuit-fence.movePart",
          "when": "editorLangId == markdown"
        },
        {
          "command": "circuit-fence.movePoint",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "tommie-fence",
      "properties": {
        "tommieFence.map.noteFrame": {
          "type": "boolean",
          "default": false,
          "description": "%config.noteFrame%"
        },
        "tommieFence.problems.erc": {
          "type": "boolean",
          "default": false,
          "description": "%config.problemsErc%"
        },
        "circuitFence.map.noteFrame": {
          "type": "boolean",
          "default": false,
          "description": "%config.oldNoteFrame%",
          "deprecationMessage": "%config.oldNoteFrame.deprecated%"
        }
      }
    }
  }
}
