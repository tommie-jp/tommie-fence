{
  "name": "part-card",
  "description": "部品カード (*.part.yaml) を読む。YAML の字を読んで fence-kit の検査に渡し、誤りを行番号つきで返す",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./cli": "./src/cli.ts",
    "./schema.json": "./schema/part-card.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fence-kit": "*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
