{
  "name": "tommie-fence",
  "version": "0.0.0",
  "description": "Markdown fences that draw electronics — schematic, breadboard, perfboard, copper-clad board, VNA screen, oscilloscope screen, spectrum screen, textbook graph, logic analyser screen",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tommie-jp/tommie-fence.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "coverage": "npm run coverage --workspaces",
    "examples": "npm run examples --workspaces --if-present",
    "docs": "npm run docs --workspaces --if-present",
    "labels": "node scripts/fence-labels.mjs",
    "labels:check": "node --test scripts/fence-labels.test.mjs && node scripts/fence-labels.mjs --check",
    "gallery:check": "node --test scripts/gallery-index.test.mjs",
    "images": "node scripts/images.mjs",
    "images:check": "node --test scripts/images.test.mjs && node scripts/images.mjs --check",
    "lint": "node scripts/lint.mjs",
    "size:check": "node --test scripts/file-size.test.mjs && node scripts/file-size.mjs",
    "profile:build": "node scripts/profile/build.mjs",
    "profile:bundle": "node scripts/profile/bundle.mjs",
    "profile:tex": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/profile/tex.mjs",
    "profile:editor": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/profile/editor.mjs",
    "profile:cli": "node scripts/profile/cli.mjs",
    "profile:render": "node --experimental-transform-types --expose-gc --disable-warning=ExperimentalWarning scripts/profile/render.mjs",
    "profile:memory": "node --experimental-transform-types --expose-gc --disable-warning=ExperimentalWarning scripts/profile/memory.mjs",
    "cards": "node packages/part-card/scripts/bake.mjs",
    "rows": "node packages/part-card/scripts/rows.mjs",
    "cards:check": "node packages/part-card/scripts/bake.mjs --check && node packages/part-card/scripts/rows.mjs --check",
    "check": "npm run labels:check && npm run gallery:check && npm run images:check && npm run size:check && npm run cards:check && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1"
  }
}
